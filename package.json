{
  "name": "a2ui-experiment-starter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Starter: Google A2UI (Lit) + experiment logging hooks + roadmap for KPI → PR loop",
  "scripts": {
    "config:sync": "node ./scripts/sync-config-to-public.mjs",
    "predev": "npm run config:sync",
    "prebuild": "npm run config:sync",
    "dev": "vite",
    "dev:ingest": "node ./server/ingest.mjs",
    "dev:policy": "node ./server/policy-context.mjs",
    "dev:stream": "node ./server/stream-surface.mjs",
    "dev:full": "concurrently -k -n web,ingest -c blue,magenta \"npm run dev\" \"npm run dev:ingest\"",
    "analyze": "node ./analyzer/analyze.mjs",
    "demo:synth": "node ./scripts/simulate-traffic.mjs 3000",
    "demo:report": "node ./scripts/simulate-traffic.mjs 800 --fresh && node ./analyzer/analyze.mjs && node ./scripts/decide-from-ndjson.mjs",
    "demo:patterns": "node ./scripts/simulate-traffic.mjs 800 --fresh && node ./scripts/decide-pattern-winners.mjs",
    "validate:config": "node ./scripts/validate-config.mjs",
    "verify": "node ./scripts/verify.mjs",
    "test:e2e": "playwright test",
    "pr:hint": "node ./scripts/open-pr-placeholder.mjs",
    "promote:patch": "node ./scripts/patch-defaults.mjs",
    "promote:patterns": "node ./scripts/decide-pattern-winners.mjs --apply",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@a2ui/lit": "^0.9.3",
    "@a2ui/markdown-it": "^0.0.3",
    "@a2ui/web_core": "^0.9.2",
    "@statsig/js-client": "^3.33.0",
    "lit": "^3.3.1",
    "posthog-js": "^1.239.0"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.6"
  }
}
