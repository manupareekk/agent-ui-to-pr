{
  "name": "a2ui-experiment-starter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Starter: Google A2UI (Lit) + experiment logging hooks + roadmap for KPI → PR loop",
  "scripts": {
    "dev": "vite",
    "dev:ingest": "node ./server/ingest.mjs",
    "dev:full": "concurrently -k -n web,ingest -c blue,magenta \"npm run dev\" \"npm run dev:ingest\"",
    "analyze": "node ./analyzer/analyze.mjs",
    "demo:synth": "node ./scripts/simulate-traffic.mjs 3000",
    "demo:report": "node ./scripts/simulate-traffic.mjs 3000 --fresh && node ./analyzer/analyze.mjs",
    "pr:hint": "node ./scripts/open-pr-placeholder.mjs",
    "promote:patch": "node ./scripts/patch-defaults.mjs",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@a2ui/lit": "^0.9.3",
    "@a2ui/markdown-it": "^0.0.3",
    "@a2ui/web_core": "^0.9.2",
    "lit": "^3.3.1",
    "posthog-js": "^1.239.0"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.6"
  }
}
