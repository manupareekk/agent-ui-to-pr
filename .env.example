# Copy to `.env` for local Vite (vars must be prefixed VITE_ to reach the client).

# --- Optional: PostHog (product analytics / experiments) ---
# npm install is already set up for posthog-js when you add a key.
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# --- Optional: forward every experiment event to your API (NDJSON-friendly) ---
# VITE_EVENTS_INGEST_URL=http://127.0.0.1:3847/events
# Ingest server (server/ingest.mjs): comma-separated top-level or payload keys to drop before append
# INGEST_REDACT_KEYS=email,phone

# --- Local policy API for agent backends (server/policy-context.mjs) ---
# POLICY_API_PORT=3890
# curl -s http://127.0.0.1:3890/api/policy-snapshot | jq .suggested_system_prompt_slice

# --- SSE demo chunks (server/stream-surface.mjs) ---
# STREAM_DEMO_PORT=3891

# --- Optional: Statsig client key (wire in src/integrations/statsig.ts — stub included) ---
# VITE_STATSIG_CLIENT_KEY=

# --- Optional: PR bot / CI (used by docs and future scripts; not read by Vite today) ---
# GITHUB_REPOSITORY=owner/repo
# GH_TOKEN=...   # fine-grained PAT or GitHub App installation token (never commit)
